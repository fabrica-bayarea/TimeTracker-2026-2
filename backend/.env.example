DATABASE_URL=postgresql://timetracker:timetracker@db:5432/timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=timetracker
POSTGRES_DB=timetracker

MAX_IDLE_SECONDS=300

# Autenticação (JWT) do gestor e do Agente Desktop
# OBRIGATÓRIA: a API não inicia sem ela. Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Mínimo de 32 caracteres. Use sempre a mesma chave entre reinicializações:
# trocá-la invalida todos os tokens (gestores precisam logar de novo e os
# Agentes precisam ser associados novamente).
JWT_SECRET_KEY=
# Validade do token de acesso, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Validade do token do Agente Desktop, em minutos (padrão: 365 dias).
AGENT_TOKEN_EXPIRE_MINUTES=525600
